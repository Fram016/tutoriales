{
  "manifest_version": 3,
  "name": "Demo XML (prueba local)",
  "version": "0.1.0",
  "description": "Stand-in local de una extensión de descargas para probar surfaces y censor del pipeline de tutoriales.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab"],
  "host_permissions": ["http://127.0.0.1:8767/*"],
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:8767/*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
