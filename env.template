# Copy this file to .env and fill it in:   copy env.template .env
# .env is ignored by git. Never commit real credentials.

# --- Google Gemini (voice + music) ---------------------------------------
# Get it at https://aistudio.google.com/apikey . Lyria has no free tier: enable billing.
GEMINI_API_KEY=

# Voice (Gemini TTS)
TTS_MODEL=gemini-3.8-flash-tts
# Prebuilt voices: Kore (firm), Charon (informative), Puck (upbeat), Aoede (breezy), Zephyr (bright)...
TTS_VOICE=Kore
TTS_STYLE=voz comercial cálida y clara, español latinoamericano neutro, ritmo ágil y profesional

# Music (Lyria). lyria-3.5 = full track of the length you ask for; lyria-3-clip-preview = 30 s clip.
MUSIC_MODEL=lyria-3.5

# --- Transcription (mode B: replicate an existing video) -----------------
# CPU only (no NVIDIA GPU): tiny | base | small | medium. small = good balance on CPU.
WHISPER_MODEL=small
WHISPER_COMPUTE=int8

# --- Mix ------------------------------------------------------------------
# Integrated loudness target in LUFS (-14 = YouTube/Instagram/TikTok standard).
LOUDNESS_TARGET=-14
# Music bed level under the voice, in dB, before ducking.
MUSIC_LEVEL_DB=-16

# --- HyperFrames ----------------------------------------------------------
HYPERFRAMES_NO_TELEMETRY=1

# --- Per-tutorial credentials --------------------------------------------
# Referenced from tutorial.yaml as env:NAME. Use DEMO accounts, never real ones.
DEMO_USER=demo@ejemplo.com
DEMO_PASSWORD=demo1234
